<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <record id="action_download_attachments" model="ir.actions.server">
        <field name="name">Download Invoices</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="binding_model_id" eval="False"/>
        <field name="state">code</field>
        <field name="code">
            action = model.action_download_attachments()
        </field>
    </record>

   <record id="menu_donwload_attachment" model="ir.ui.menu">
    <field name="action" ref="action_download_attachments"/>
    <field name="active" eval="True"/>
    <field name="groups_id" eval="[(6, 0, [])]"/>
    <field name="name">Download Attachments</field>
    <field name="parent_id" ref="account.menu_account_config"/>
    <field name="sequence">100</field>
    <field name="web_icon" eval="False"/>
  </record>


</odoo>