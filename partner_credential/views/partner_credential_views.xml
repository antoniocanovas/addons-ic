<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <record id="credential_tree" model="ir.ui.view">
        <field name="arch" type="xml">
            <tree string="Credentials">
                <field name="name" modifiers="{}"/>
                <field name="partner_id"/>
                <field name="create_uid" widget="many2one_avatar_user" optional="show"/>
                <field name="activity_ids" widget="list_activity" optional="show"/>
                <field name="category_id"/>
            </tree>
        </field>
        <field name="model">partner.credential</field>
        <field name="name">Default tree view for partner credentials</field>
        <field name="type">tree</field>
    </record>

    <record id="credential_form" model="ir.ui.view">
        <field name="arch" type="xml">
            <form>
                <sheet name="main" string="Credentials">
                    <div class="oe_button_box" name="button_box">
                        <button string="Password" class="oe_stat_button" icon="fa-eye"
                                type="object" name="action_view_password" groups="base.group_user"
                        />
                        <button string="2FA" class="oe_stat_button" icon="fa-key"
                                attrs="{'invisible':[('key_2fa_secret', '=', False )]}"
                                type="object" name="get_f2a_key" groups="base.group_user"
                        />
                    </div>
                    <h2>
                        <field name="name" placeholder="Easy name ..."/>
                    </h2>
                    <group name="basic_params">
                        <group>
                            <!-- Campo
                            <field name="categ_ids" invisible="1"/>
                            -->
                            <field name="url" widget="url" placeholder="https://www.ejemplos.com"/>
                            <field name="partner_id"/>
                            <field name="category_id"/>
                        </group>
                        <group>
                            <field name="user"/>
                            <field name="password" password="1" widget="CopyClipboardChar"/>
                            <field name="key_2fa" widget="CopyClipboardChar" readonly="1" attrs="{'invisible':[('key_2fa_secret', '=', False )]}"/>
                            <field name="key_2fa_time_remaining" readonly="1" attrs="{'invisible':[('key_2fa_secret', '=', False )]}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" class="field_description" placeholder="Description..." widget="html"/>
                        </page>
                        <page string="Security">
                            <group>
                                <field name="key_2fa_secret"/>
                            </group>
                            <group>
                                <field name="department_categ_ids" widget="many2many_tags"/>
                                <field name="department_ids" widget="many2many_tags"
                                       domain="[('id','not in', department_categ_ids)]"
                                       attrs="{'readonly':[('user_can_edit','=',False),('id','!=',False)]}"/>
                                <field name="user_ids" invisible="1"/>
                                <field name="pass_updated"/>
                                <field name="user_can_edit" invisible="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread" options="{'post_refresh':'recipients'}"/>
                </div>
            </form>
        </field>
        <field name="model">partner.credential</field>
        <field name="name">Default form view for partner credentials</field>
        <field name="type">form</field>
    </record>


</odoo>