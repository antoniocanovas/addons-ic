<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <record id="credential_category_tree" model="ir.ui.view">
        <field name="arch" type="xml">
            <tree string="Credentials category" editable="bottom">
                <field name="name"/>
                <field name="department_ids" widget="many2many_tags"/>
                <field name="logo" widget="image" options="{'size': [60, 60]}"/>
                <field name="create_uid" widget="many2one_avatar_user" optional="hide"/>
            </tree>
        </field>
        <field name="model">partner.credential.category</field>
        <field name="name">Default tree view for partner credentials category</field>
        <field name="type">tree</field>
    </record>


    <record id="credential_category_view_kanban" model="ir.ui.view">
        <field name="name">credential.category.kanban</field>
        <field name="model">partner.credential.category</field>
        <field name="arch" type="xml">
            <kanban string="Partner credential category" class="o_kanban_mobile" action="action_view_credentials" type="object" sample="1" default_order="name, id">
                <field name="create_uid" string="Created by"/>
                <field name="credential_count"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_content oe_kanban_global_click o_kanban_get_form">
                            <div class="row">
                                <div class="col-12">
                                    <strong><field name="name" string="Category Name"/></strong>
                                </div>
                                <div>
                                    <field name="logo" display="full" options="{&quot;size&quot;:[0,90]}" widget="image"/>
                                    <field name="department_ids" display="full" widget="many2many_tags"/>
                                </div>

                                <div class="o_kanban_record_bottom mt-3">
                                    <div class="oe_kanban_bottom_left">
                                        <div class="o_project_kanban_boxes d-flex align-items-baseline">
                                            <div>
                                                <span class="o_value"><t t-esc="record.credential_count.value"/></span>
                                                <span class="o_label ms-1">Credentials</span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <field name="create_uid" widget="many2one_avatar_user" t-if="record.create_uid.raw_value"/>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="act_credential_category_2_credential_all" model="ir.actions.act_window">
        <field name="name">Credentials</field>
        <field name="res_model">partner.credential</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('category_id', '=', active_id)]</field>
        <field name="context">{'default_category_id': active_id}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No credentials found. Let's create one!
            </p>
        </field>
    </record>


</odoo>